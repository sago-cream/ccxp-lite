# Copy to .env.release.local and fill it locally, or inject these variables
# from a password manager / CI secret store. Never commit real credentials.
# Load explicitly with: bun --env-file=.env.release.local <command>

# Chrome Web Store: OAuth client with chromewebstore scope and a refresh token.
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=glcnfmnbmknbphfgjgbokbbchahmiakk
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Mozilla Add-ons: API credentials from the developer account.
AMO_ADDON_ID=ccxplite
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# GitHub: local releases normally reuse `gh auth login` via the keychain.
# Set this only when injecting a token directly (for example, in CI).
# GITHUB_TOKEN=
