# Copy to .env.release.local and fill it locally, or inject these variables
# from a password manager / CI secret store. Never commit real credentials.
# Load explicitly with: bun --env-file=.env.release.local <command>

# Chrome Web Store: personal service account with short-lived tokens minted by gcloud.
# No key file is needed. The named personal account must have permission to impersonate it.
CWS_SERVICE_ACCOUNT_EMAIL=ccxplite-release@ccxplite-releases.iam.gserviceaccount.com
CWS_GCLOUD_ACCOUNT=

# Publisher/item IDs (public configuration).
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=glcnfmnbmknbphfgjgbokbbchahmiakk
# Alternative OAuth authentication (unused when CWS_SERVICE_ACCOUNT_EMAIL is set).
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Mozilla Add-ons: API credentials from the developer account.
AMO_ADDON_ID=ccxplite
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# GitHub: local releases normally reuse `gh auth login` via the keychain.
# Set this only when injecting a token directly (for example, in CI).
# GITHUB_TOKEN=
